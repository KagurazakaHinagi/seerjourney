{
  "name": "seerjourney",
  "version": "1.0.0",
  "private": true,
  "description": "Shared campaign maps, journals, and supplies with read-only guests and passphrase editing",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "build": "node --env-file-if-exists=.env scripts/build.cjs",
    "dev": "node --env-file-if-exists=.env scripts/dev.cjs",
    "test": "node --require ./tests/setup.cjs --test tests/client/*.test.cjs tests/server/*.test.cjs tests/shared/*.test.cjs tests/tooling/*.test.cjs",
    "map:stage": "node --env-file-if-exists=.env scripts/stage-map.cjs",
    "release:prepare": "node scripts/prepare-release.cjs",
    "licenses:check": "node scripts/check-licenses.cjs",
    "map:unpack": "node scripts/unpack-map.cjs"
  },
  "dependencies": {
    "@vercel/blob": "2.9.0",
    "dompurify": "3.4.18",
    "marked": "18.2.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jsdom": "31.0.1"
  },
  "overrides": {
    "zod": "4.6.6"
  },
  "license": "Apache-2.0"
}

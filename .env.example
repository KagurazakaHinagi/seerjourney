# Local development only. Vercel must use Redis; never set CAMPAIGN_STORE=file there.
CAMPAIGN_STORE=file
# CAMPAIGN_DATA_FILE=.data/campaign.json

# JSON array of permitted editor passphrases (8–512 characters each).
# Replace these examples. Never prefix server secrets with NEXT_PUBLIC_ or VITE_.
CAMPAIGN_PASSPHRASES='["replace-with-a-long-private-passphrase"]'
# Generate a secret with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-at-least-32-random-characters

# Vercel production: set CAMPAIGN_STORE=redis and connect an Upstash Redis database.
# All deployments sharing this database and CAMPAIGN_ID share the same campaign.
# Use separate databases or IDs for Preview and Production.
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-server-only-token
# The Vercel integration's KV_REST_API_URL/KV_REST_API_TOKEN names also work.
CAMPAIGN_ID=my-campaign

# Image attachments use a linked public Vercel Blob store in production.
# Connect it to this Vercel project: deployment OIDC supplies authorization.
# BLOB_STORE_ID=store_your_store_id
# BLOB_WEBHOOK_PUBLIC_KEY=provided-by-vercel
# Optional token fallback for non-Vercel servers; never expose it in the client.
# BLOB_READ_WRITE_TOKEN=server-only-token
# Explicit local file mode stores uploaded images beside CAMPAIGN_DATA_FILE.

# Optional external editable map folder; not a URL or a portable mod file.
# CAMPAIGN_MAP_DIR=/absolute/path/to/my-map
# Require an external/staged map (recommended for non-demo deployments).
# CAMPAIGN_MAP_REQUIRED=1
